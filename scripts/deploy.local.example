# Do not commit real hostnames or keys.

GCP_SSH_HOST=YOUR_VM_EXTERNAL_IP
GCP_SSH_USER=YOUR_LINUX_USERNAME
GCP_DEPLOY_PATH=/home/YOUR_LINUX_USERNAME/crypto-trade-bot

