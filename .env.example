MODE=paper

# OKX credentials (required for live mode, optional for public market data)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
TIMEFRAME=5m
POLL_SECONDS=20
LOOKBACK_CANDLES=200

# Leverage and position sizing
INITIAL_EQUITY=10000
TARGET_LEVERAGE=3
MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=0.5

# Risk guardrails
MAX_DAILY_LOSS_PCT=2.0
MAX_CONSECUTIVE_LOSSES=3

# Strategy params
FAST_EMA=20
SLOW_EMA=50
ATR_PERIOD=14
ATR_MIN_PCT=0.2
STOP_ATR_MULTIPLIER=1.8
TAKE_PROFIT_R=1.5

# Paper execution assumptions
FEE_BPS=6
SLIPPAGE_BPS=2
