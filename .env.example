# Copy to `.env` and replace placeholders. Values below are fake examples for a public repo -- not real credentials.

MODE=paper

# Hyperliquid (required for live mode; optional for public market data in paper)
# wallet = 0x + 40 hex chars; private_key = 64 hex chars (0x prefix ok per your setup)
HL_WALLET_ADDRESS=0x1111111111111111111111111111111111111111
HL_PRIVATE_KEY=0x2222222222222222222222222222222222222222222222222222222222222222
HL_TESTNET=false

SYMBOLS=BTC/USDC:USDC,ETH/USDC:USDC
TIMEFRAME=15m
POLL_SECONDS=30
HEARTBEAT_INTERVAL=5
LOOKBACK_CANDLES=200

# ============================================================================
# Strategy: long-only DCA-on-dips with trailing-stop exit
# ============================================================================

# Per-symbol price ceiling for entries. Format: BASE:PRICE,BASE:PRICE,...
# Symbols above their cap are skipped (no new legs); existing positions still
# manage their own trailing exit.  Symbols not listed here are uncapped.
LONG_MAX_PRICES=BTC:90000,ETH:3000

# Initial entry: open the first leg when, within the last DIP_MEMORY_BARS closed
# bars, some bar closed at or below local_high * (1 - INITIAL_DIP_PCT/100), AND
# (optionally) the most recent closed bar is green (close > open).  The memory
# window catches dips that already bounced a few bars; the green-bar filter
# avoids catching falling knives.
INITIAL_DIP_PCT=3.0
HIGH_LOOKBACK_CANDLES=96          # 96 x 15m = 24h
DIP_MEMORY_BARS=6                 # scan last 6 closed bars for a qualifying dip (~90m at 15m)
REQUIRE_GREEN_CONFIRMATION=true   # only enter on a bullish bar after the dip

# DCA adds: while a position is open and legs < MAX_DCA_LEGS, add another leg
# when last close has dropped this many % below the *most recent leg's* fill price.
DCA_TRIGGER_PCT=10.0
MAX_DCA_LEGS=5

# Leg sizing: each leg's notional = LEG_NOTIONAL_PCT % of INITIAL_EQUITY.
# At max legs you'll have ~ LEG_NOTIONAL_PCT * MAX_DCA_LEGS % of equity deployed per symbol.
LEG_NOTIONAL_PCT=10.0

# Trailing exit: arm trailing once price is this many % above the size-weighted
# average entry; thereafter exit ALL legs if price drops this many % below the
# running peak. No hard stop loss in this strategy.
TRAIL_ACTIVATE_PCT=5.0
TRAIL_DISTANCE_PCT=3.0

# ============================================================================
# Portfolio risk guardrails (still apply)
# ============================================================================

INITIAL_EQUITY=10000
MAX_LEVERAGE=3

# Rolling drawdown halt: pauses NEW entries (does not close open legs) when
# realised equity has dropped this % from the window start. Resets after halt expires.
MAX_DAILY_LOSS_PCT=2.0
DAILY_LOSS_HALT_HOURS=12

# Consecutive losing trades trigger a longer pause.
MAX_CONSECUTIVE_LOSSES=3
CONSEC_HALT_HOURS=6

# ============================================================================
# Execution
# ============================================================================

ENTRY_FEE_BPS=2
EXIT_FEE_BPS=3.5
SLIPPAGE_BPS=2
LIMIT_TIMEOUT_SECONDS=30          # legacy; DCA bot uses immediate fills (paper) / market orders (live)

# ============================================================================
# Daily Telegram briefing (Gemini summarises logs/trades.jsonl + events.jsonl)
# Put real tokens only in your local `.env` (never commit that file).
# ============================================================================

DAILY_BRIEFING_ENABLED=false
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789
GEMINI_API_KEY=AIzaSyNotARealKeyReplaceWithYourGoogleAIStudioKey
GEMINI_MODEL=gemini-2.5-flash
DAILY_BRIEFING_HOUR_UTC=6

# ============================================================================
# Web dashboard (read-only monitoring UI) -- python -m src.webapp
# ============================================================================

# 0.0.0.0 exposes it on the VM's external IP (open the firewall port in GCP).
# Use 127.0.0.1 to keep it local-only behind an SSH tunnel or nginx proxy.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ============================================================================
# Two-way Telegram control (agentic) -- python -m src.telegram_control
# Reuses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / GEMINI_API_KEY above.
# Only messages from TELEGRAM_CHAT_ID are honored. The agent can read stats
# and pause/resume trading ONLY -- it can never open or close positions.
# ============================================================================

TELEGRAM_CONTROL_ENABLED=false

# ============================================================================
# Deprecated knobs (unused in DCA strategy, kept for back-compat)
# ============================================================================

RISK_PER_TRADE_PCT=0.5
FAST_EMA=9
SLOW_EMA=21
ATR_PERIOD=14
ATR_MIN_PCT=0.15
STOP_ATR_MULTIPLIER=2.5
TAKE_PROFIT_R=2.0
COOLDOWN_CANDLES=0
POST_STOP_CANDLES=1
HTF_TIMEFRAME=1h
STOP_ATR_SOURCE=htf
TRAIL_AFTER_R=0
TRAIL_ATR_MULTIPLIER=2.0
VOLUME_MIN_MULT=0
