# Copy to `.env` and replace placeholders. Values below are fake examples for a public repo -- not real credentials.

MODE=paper

# Hyperliquid (required for live mode; optional for public market data in paper)
# wallet = 0x + 40 hex chars; private_key = 64 hex chars (0x prefix ok per your setup)
HL_WALLET_ADDRESS=0x1111111111111111111111111111111111111111
HL_PRIVATE_KEY=0x2222222222222222222222222222222222222222222222222222222222222222
HL_TESTNET=false

SYMBOLS=BTC/USDC:USDC,ETH/USDC:USDC
TIMEFRAME=15m
POLL_SECONDS=30
HEARTBEAT_INTERVAL=5
LOOKBACK_CANDLES=200

# Log volume control (see src/log_hygiene.py). Routine heartbeats omit the
# positions/statuses snapshot; logs/state.json always holds the latest one.
LOG_SLIM_HEARTBEAT=true
LOG_HEARTBEAT_VERBOSE_EVERY=20
LOG_ERROR_MAX_CHARS=300

# Per-symbol trade direction under DIRECTION_MODE=static: bases listed here are
# traded SHORT-only (mirror logic: sell rips, trail down), everything else is
# LONG-only. Leave empty for long-only. Ignored when DIRECTION_MODE=signal.
# Example to short two coins: SHORT_SYMBOLS=TRUMP,HYPE
SHORT_SYMBOLS=

# Strategy selector:
#   trend = EMA-cross trend-following with a regime EMA filter, ATR stops,
#           ATR chandelier trail, and fixed-fractional (risk %) sizing
#   hedge = no automatic directional trading; only the manual catalyst hedge
#           (arm via Telegram /hedge arm). Requires HEDGE_ENABLED=true.
# A retired `dca` value now raises at startup instead of trading unexpectedly.
STRATEGY=trend

# ============================================================================
# Portfolio risk guardrails
# ============================================================================

INITIAL_EQUITY=10000
MAX_LEVERAGE=3

# Rolling drawdown halt: pauses NEW entries (does not close open legs) when
# realised equity has dropped this % from the window start. Resets after halt expires.
MAX_DAILY_LOSS_PCT=2.0
DAILY_LOSS_HALT_HOURS=12

# Consecutive losing trades trigger a longer pause.
MAX_CONSECUTIVE_LOSSES=3
CONSEC_HALT_HOURS=6

# ============================================================================
# Execution
# ============================================================================

ENTRY_FEE_BPS=2
EXIT_FEE_BPS=3.5
SLIPPAGE_BPS=2

# ============================================================================
# Daily Telegram briefing (Gemini summarises logs/trades.jsonl + events.jsonl)
# Put real tokens only in your local `.env` (never commit that file).
# ============================================================================

DAILY_BRIEFING_ENABLED=false
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789
GEMINI_API_KEY=AIzaSyNotARealKeyReplaceWithYourGoogleAIStudioKey
GEMINI_MODEL=gemini-2.5-flash
DAILY_BRIEFING_HOUR_UTC=6

# ============================================================================
# Web dashboard (read-only monitoring UI) -- python -m src.webapp
# ============================================================================

# 0.0.0.0 exposes it on the VM's external IP (open the firewall port in GCP).
# Use 127.0.0.1 to keep it local-only behind an SSH tunnel or nginx proxy.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Public demo with fake data (reads demo_logs/ in the repo, never your real logs/).
# Use this on a VM you expose to the internet for portfolio / internship reviewers.
DASHBOARD_DEMO_MODE=false

# ============================================================================
# Two-way Telegram control (agentic) -- python -m src.telegram_control
# Reuses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / GEMINI_API_KEY above.
# Only messages from TELEGRAM_CHAT_ID are honored. The agent can read stats
# and pause/resume trading ONLY -- it can never open or close positions.
# ============================================================================

TELEGRAM_CONTROL_ENABLED=false

# ============================================================================
# Manual catalyst hedge (opt-in) -- see README "Catalyst hedge"
# Opens a mirrored long + short on one coin before a scheduled event. Whichever
# stop the market reaches first identifies the losing leg; it is cut for a
# capped loss and the survivor trails.
#
# Hyperliquid nets one position per coin, so the short leg lives in a
# SUB-ACCOUNT. Create and fund it in the Hyperliquid UI (an API wallet cannot),
# then verify with:  python -m src.subaccount preflight
#
# A hedge cannot make money on its own: the loser's realized loss always equals
# the winner's unrealized gain at the cut. It buys a fixed cost basis through a
# gap, and it costs an extra round trip in fees. Arm it for events, not daily.
# ============================================================================

HEDGE_ENABLED=false
# Sub-account address that holds the short leg (0x..., from `subaccount status`)
HEDGE_SUB_ACCOUNT=
# Second approved API wallet for the short leg. Hyperliquid tracks nonces per
# signer, so reusing HL_PRIVATE_KEY for both legs can collide when they fire
# together. Strongly recommended.
HEDGE_SUB_PRIVATE_KEY=
# Coins the hedge may be armed on (defaults to SYMBOLS)
HEDGE_SYMBOLS=
# Percent of combined (main + sub) equity risked per leg
HEDGE_RISK_PCT=0.5
# Initial stop distance, in reference ATRs. This is the capped loss.
HEDGE_STOP_ATR_MULT=2.0
# Winner's trailing distance, in reference ATRs
HEDGE_TRAIL_ATR_MULT=4.0
# Floor the reference ATR at this percentile of its own recent history.
# Catalysts happen when volatility is compressed, and sizing stops off a
# squeezed ATR gets both legs whipsawed. 0 disables the floor.
HEDGE_ATR_FLOOR_PCT=50.0
# Auto-close a hedge that never triggered, in hours (0 disables)
HEDGE_MAX_HOURS=48
# An armed-but-unopened request expires after this many hours
HEDGE_EXPIRY_HOURS=12

# ============================================================================
# Trend-following strategy (active when STRATEGY=trend)
# Long when fast EMA > slow EMA AND price > TREND_EMA_PERIOD EMA (regime up);
# short mirror for SHORT_SYMBOLS. Initial stop = STOP_ATR_MULTIPLIER * ATR,
# then trail with a chandelier at TRAIL_ATR_MULTIPLIER * ATR from the extreme.
# Size each trade so the stop distance risks RISK_PER_TRADE_PCT of equity.
# ============================================================================

# How each symbol's trade direction is decided:
#   static = SHORT_SYMBOLS decides, fixed for the life of the process. A symbol
#            never takes the other side, so SHORT_SYMBOLS=BTC,ETH shorts every
#            signal and stands aside through every rally.
#   signal = the trend picks the side per bar; SHORT_SYMBOLS is ignored. Roughly
#            doubles the trade count (both sides now tradeable) and therefore
#            the fees. An already-open position never flips.
# 22mo 4h BTC/ETH: static short-only +17.5% (PF 1.35, DD 11.2%), static
# long-only +27.3% (PF 1.58, DD 13.0%), signal +51.9% (PF 1.50, DD 14.6%).
DIRECTION_MODE=static

# Backtested best on the 4h timeframe (set TIMEFRAME=4h when STRATEGY=trend).
TREND_EMA_PERIOD=200        # regime EMA: price must be on its favorable side
RISK_PER_TRADE_PCT=1.0      # % of equity risked per trade (stop distance)
FAST_EMA=50                 # fast EMA for the trend cross
SLOW_EMA=200                # slow EMA for the trend cross
ATR_PERIOD=14               # ATR lookback for stops/sizing
STOP_ATR_MULTIPLIER=3.0     # initial stop = entry -/+ this * ATR
TRAIL_ATR_MULTIPLIER=6.0    # chandelier trail = extreme -/+ this * ATR (wide = let winners run)

# ============================================================================
# Entry-quality filters (opt-in). All disabled by default so existing
# backtests/behaviour are unchanged until you turn one on. Each returns
# "blocked" when there is not enough history to decide, so a cold start never
# enters on thin data.
# Backtesting the MTF filter requires cached HTF data:
#   python -m src.fetch_candles --timeframes 4h
# ============================================================================

# Chop filter: skip EMA-cross entries unless trend strength
# (Wilder ADX over ADX_PERIOD) is at least ADX_MIN. 0 = disabled.
ADX_PERIOD=14
ADX_MIN=0                   # try 25 to suppress entries in choppy/ranging markets

# Volume confirmation: require the entry bar's volume to exceed VOLUME_MIN_MULT
# times the VOLUME_MA_PERIOD volume average. 0 = disabled.
VOLUME_MA_PERIOD=20
VOLUME_MIN_MULT=0           # try 1.5 to require above-average participation

# Multi-timeframe alignment: only take long entries when the higher timeframe
# closes above its MTF_EMA_PERIOD EMA (and the mirror for shorts).
MTF_ENABLED=false
MTF_TIMEFRAME=4h
MTF_EMA_PERIOD=50
