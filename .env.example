# Copy to `.env` and replace placeholders. Values below are fake examples for a public repo — not real credentials.

MODE=paper

# Hyperliquid (required for live mode; optional for public market data in paper)
# wallet = 0x + 40 hex chars; private_key = 64 hex chars (0x prefix ok per your setup)
HL_WALLET_ADDRESS=0x1111111111111111111111111111111111111111
HL_PRIVATE_KEY=0x2222222222222222222222222222222222222222222222222222222222222222
HL_TESTNET=false

SYMBOLS=BTC/USDC:USDC,ETH/USDC:USDC
TIMEFRAME=15m
POLL_SECONDS=30
HEARTBEAT_INTERVAL=5
LOOKBACK_CANDLES=200

# Leverage and position sizing
INITIAL_EQUITY=10000
MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=0.5

# Risk guardrails
MAX_DAILY_LOSS_PCT=2.0         # rolling drawdown % that triggers a halt
MAX_CONSECUTIVE_LOSSES=3       # loss streak that triggers a halt

# Strategy params
FAST_EMA=9
SLOW_EMA=21
ATR_PERIOD=14
ATR_MIN_PCT=0.15
STOP_ATR_MULTIPLIER=2.5
TAKE_PROFIT_R=2.0
COOLDOWN_CANDLES=0
POST_STOP_CANDLES=1

# Higher-timeframe trend filter (leave empty to disable)
HTF_TIMEFRAME=1h
STOP_ATR_SOURCE=htf            # "primary" or "htf" — which ATR to use for stop distance

# Trailing stop (set TRAIL_AFTER_R=0 to disable)
TRAIL_AFTER_R=0
TRAIL_ATR_MULTIPLIER=2.0

# Volume filter (0 = disabled)
VOLUME_MIN_MULT=0

# Halt durations (hours) when risk guards trigger
CONSEC_HALT_HOURS=6            # pause after max consecutive losses
DAILY_LOSS_HALT_HOURS=12       # pause after rolling drawdown breach

# Execution assumptions (Hyperliquid: maker ~2bps, taker ~3.5bps)
ENTRY_FEE_BPS=2
EXIT_FEE_BPS=3.5
SLIPPAGE_BPS=2
LIMIT_TIMEOUT_SECONDS=30

# Daily Telegram briefing (Gemini summarizes logs/trades.jsonl + events.jsonl)
# Put real tokens only in your local `.env` (never commit that file).
DAILY_BRIEFING_ENABLED=false
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789
GEMINI_API_KEY=AIzaSyNotARealKeyReplaceWithYourGoogleAIStudioKey
GEMINI_MODEL=gemini-2.5-flash
DAILY_BRIEFING_HOUR_UTC=6
