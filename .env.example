MODE=paper

# OKX credentials (required for live mode, optional for public market data)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
TIMEFRAME=15m
POLL_SECONDS=30
HEARTBEAT_INTERVAL=5
LOOKBACK_CANDLES=200

# Leverage and position sizing
INITIAL_EQUITY=10000
MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=0.5

# Risk guardrails
MAX_DAILY_LOSS_PCT=2.0         # rolling drawdown % that triggers a halt
MAX_CONSECUTIVE_LOSSES=3       # loss streak that triggers a halt

# Strategy params
FAST_EMA=9
SLOW_EMA=21
ATR_PERIOD=14
ATR_MIN_PCT=0.15
STOP_ATR_MULTIPLIER=2.5
TAKE_PROFIT_R=2.0
COOLDOWN_CANDLES=8

# Higher-timeframe trend filter (leave empty to disable)
HTF_TIMEFRAME=1h
STOP_ATR_SOURCE=htf            # "primary" or "htf" — which ATR to use for stop distance

# Trailing stop (set TRAIL_AFTER_R=0 to disable)
TRAIL_AFTER_R=0
TRAIL_ATR_MULTIPLIER=2.0

# Volume filter (0 = disabled)
VOLUME_MIN_MULT=0

# Halt durations (hours) when risk guards trigger
CONSEC_HALT_HOURS=6            # pause after max consecutive losses
DAILY_LOSS_HALT_HOURS=12       # pause after rolling drawdown breach

# Execution assumptions (limit entry = maker fee, market exit = taker fee)
ENTRY_FEE_BPS=2
EXIT_FEE_BPS=5
SLIPPAGE_BPS=2
LIMIT_TIMEOUT_SECONDS=30
